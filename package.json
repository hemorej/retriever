{
  "name": "retriever",
  "version": "0.1.0",
  "private": true,
  "description": "Image and catalog browsing desktop app",
  "main": "src/main/index.js",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "dist": "electron-builder --mac --dir"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "hash-wasm": "^4.11.0",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^44.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.retriever.app",
    "productName": "Retriever",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "package.json",
      "!design_handoff_retriever/**/*"
    ],
    "mac": {
      "icon": "src/renderer/icon.png",
      "category": "public.app-category.graphics-design",
      "target": "dir"
    }
  }
}
